{
  "name": "posthub",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Muhammad-Arsalan31/posthub"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @posthub/server start",
    "test": "turbo run test",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "db:generate": "pnpm --filter @posthub/db db:generate",
    "db:migrate": "pnpm --filter @posthub/db db:migrate",
    "db:studio": "pnpm --filter @posthub/db db:studio",
    "release": "vpx packages/release/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.18.0"
}
