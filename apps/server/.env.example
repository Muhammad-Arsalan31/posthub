# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Encrypts platform credentials at rest. Changing it means reconnecting every account.
POSTHUB_ENCRYPTION_KEY=
# URL the browser uses. Dev = Vite dev server (it proxies /api, /rpc and /connect to this server).
BETTER_AUTH_URL=http://localhost:5173
PORT=4100

# ── Connectors (optional) ──────────────────────────────────────────────────
# Easiest: set up each app on the Accounts page (stored encrypted in the DB, applied with no restart).
# Values here are a fallback; anything saved in the UI overrides them.
# Each provider turns on when both its values are set. OAuth redirect URL to register:
#   <BETTER_AUTH_URL>/connect/<google|meta|linkedin>/callback
# WordPress needs nothing here; connect sites with an Application Password in the UI.

# YouTube: Google Cloud Console → APIs & Services → enable "YouTube Data API v3",
# then Credentials → OAuth client ID (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# public | unlisted | private (unverified Google projects can only upload private videos)
# YOUTUBE_PRIVACY=public

# Facebook Pages + Instagram (Business/Creator linked to a Page): developers.facebook.com → Create app
# (Business type) → add Facebook Login for Business; use the App ID and App Secret.
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v26.0

# LinkedIn: linkedin.com/developers → Create app → Products: "Sign In with LinkedIn using
# OpenID Connect" and "Share on LinkedIn".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202608

# Optional overrides
# POSTHUB_DATA_DIR=C:\Users\you\AppData\Roaming\PostHub
